STORYBLOK_DELIVERY_API_TOKEN=your_storyblok_delivery_api_token_here
# Only `npm run types:storyblok` reads this — the app never does. Space
# settings in Storyblok, or the number in the space URL.
STORYBLOK_SPACE_ID=your_storyblok_space_id_here

# Supabase — server-side only. None of these are exposed to the browser.
# Uses the current API key system: publishable replaces anon, secret replaces
# service_role. The secret key bypasses RLS, so it must never reach a client
# bundle or runtimeConfig.public.
SUPABASE_URL=your_supabase_url_here
# Only `npm run types:supabase` reads this — the subdomain of SUPABASE_URL
# (https://<ref>.supabase.co).
SUPABASE_PROJECT_REF=your_supabase_project_ref_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Peppers for one-way hashes (invite codes, visitor fingerprints). Kept out of
# the database so a DB leak alone does not make the hashes reversible.
# Generate each with: openssl rand -base64 48
OTP_PEPPER=generate_with_openssl_rand_base64_48
VISIT_PEPPER=generate_with_openssl_rand_base64_48

BUNNY_STREAM_HOSTNAME=your_bunny_stream_hostname_here
BUNNY_STREAM_LIBRARY_ID=your_bunny_stream_library_id_here
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key_here

# PostHog. Two DIFFERENT hosts are involved and mixing them up returns 404:
#   POSTHOG_HOST      ingestion, used by the browser  (us.i.posthog.com)
#   POSTHOG_API_HOST  queries, used server-side       (us.posthog.com)
# Leave POSTHOG_API_HOST unset and it is derived by dropping the "i." — that
# holds for both regions.
#
# The PROJECT key is write-only and safe in the browser. The PERSONAL key can
# read every visitor event in the project: keep it server-side, give it only
# the `query:read` scope, and scope it to this one project.
POSTHOG_PROJECT_API_KEY=phc_xxxxxxxxxxxxxxxx
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_HOST=https://us.posthog.com

# MailerSend sends every transactional email: the invite welcome, password
# resets and email-change confirmations. Missing, those sends fail quietly —
# they are wrapped in try/catch so a mail outage cannot break a signup.
MAILERSEND_API_KEY=
# Optional; both fall back to sensible values in nuxt.config.ts.
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=

# Bearer token Vercel Cron sends to /api/internal/purge-deletions. The daily
# deletion purge answers 503 without it.
CRON_SECRET=

# The canonical site URL. In production this MUST be the live origin, not this
# value: it drives canonical tags, OG image URLs, the sitemap, and — together
# with VERCEL_ENV, which Vercel sets itself — whether robots.txt allows
# crawling at all.
NUXT_PUBLIC_SITE_URL=https://localhost:3000/
