{
	"name": "nuxt4-template",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --ssl-cert ./keys/localhost.pem --ssl-key ./keys/localhost-key.pem",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"types:supabase": "supabase gen types typescript --project-id YOUR_SUPABASE_PROJECT_REF --schema public > app/types/supabase.d.ts",
		"whop:surface": "node scripts/whop-surface.mjs"
	},
	"dependencies": {
		"@nuxt/eslint": "^1.12.1",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/icon": "^2.2.0",
		"@nuxt/image": "^2.0.0",
		"@nuxt/scripts": "^1.1.0",
		"@nuxtjs/i18n": "^10.2.1",
		"@nuxtjs/seo": "^5.1.3",
		"@storyblok/nuxt": "^10.1.6",
		"@storyblok/richtext": "^4.3.1",
		"@supabase/supabase-js": "^2.89.0",
		"@unhead/vue": "^3.1.0",
		"@vueuse/nuxt": "^14.1.0",
		"@whop/sdk": "^0.0.42",
		"autoprefixer": "^10.4.23",
		"dotenv": "^17.2.3",
		"eslint": "^10.3.0",
		"gsap": "^3.14.2",
		"hls.js": "^1.6.15",
		"lenis": "^1.3.17",
		"nuxt": "^4.1.3",
		"nuxt-og-image": "^6.3.9",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"posthog-js": "^1.414.0",
		"qrcode": "^1.5.4",
		"three": "^0.185.1",
		"vue": "^3.5.26",
		"vue-router": "^5.0.7"
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.185.1",
		"less": "^4.5.1",
		"typescript": "^6.0.3",
		"vite-plugin-checker": "^0.13.0",
		"vue-tsc": "^3.2.2"
	}
}
