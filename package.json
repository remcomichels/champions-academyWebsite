{
	"name": "nuxt4-template",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --ssl-cert ./keys/localhost.pem --ssl-key ./keys/localhost-key.pem",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"types:supabase": "set -a && . ./.env && set +a && supabase gen types typescript --project-id \"${SUPABASE_PROJECT_REF:?set SUPABASE_PROJECT_REF in .env}\" --schema public > app/types/supabase.d.ts",
		"types:storyblok": "set -a && . ./.env && set +a && storyblok components pull --space \"${STORYBLOK_SPACE_ID:?set STORYBLOK_SPACE_ID in .env}\" && storyblok types generate --space \"$STORYBLOK_SPACE_ID\" --filename storyblok.gen --type-suffix Blok"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=12"
	},
	"dependencies": {
		"@nuxt/eslint": "^1.12.1",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/image": "^2.0.0",
		"@nuxtjs/i18n": "^10.2.1",
		"@nuxtjs/seo": "^5.1.3",
		"@storyblok/nuxt": "^10.1.6",
		"@supabase/supabase-js": "^2.89.0",
		"@vueuse/nuxt": "^14.1.0",
		"dotenv": "^17.2.3",
		"eslint": "^10.3.0",
		"gsap": "^3.14.2",
		"hls.js": "^1.6.15",
		"lenis": "^1.3.17",
		"nuxt": "^4.1.3",
		"posthog-js": "^1.414.0",
		"qrcode": "^1.5.4",
		"three": "^0.185.1",
		"vue": "^3.5.26",
		"vue-router": "^5.0.7"
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.185.1",
		"less": "^4.5.1",
		"storyblok": "^4.22.4",
		"typescript": "^6.0.3",
		"vite-plugin-checker": "^0.13.0",
		"vue-tsc": "^3.2.2"
	}
}
