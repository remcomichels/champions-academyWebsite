# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
# Written by the Nuxt Vercel preset on every local build.
.vercel

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Certificates and private keys: the HTTPS dev certs in keys/ (each machine
# makes its own with mkcert), and client certificates for outside APIs, which
# live base64-encoded in .env and never as files in the repo.
/keys/
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
# Claude Code checks worktrees out in-repo; they are local scratch, never committed.
.claude/worktrees/

# Storyblok CLI working directory. The generated types are committed — they are
# source, and they import each other by relative path so they have to stay in
# the CLI's own layout. The schema dump, logs and run reports are not.
.storyblok/*
!.storyblok/types/
